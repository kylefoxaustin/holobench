#!/usr/bin/env bash
# Run the suite before every commit.
#
# ⚠️ WHY THIS EXISTS (2026-08-27). For 24 commits this session I reported "138 tests
# green" on each one — and NOTHING RAN THEM but my habit of typing pytest in the same
# bash call. No hook, no CI, no Makefile target. The tests existed, were correct, and
# were INERT BY WIRING: the moment anyone committed without the habit, the claim would
# have decayed silently and nothing would have said so.
#
# qualcomm's warning, which is what prompted the check: "it is not enough that a
# self-test exists and passes when you run it by hand. Check that the thing which runs
# on every commit actually INVOKES it." Theirs did not, for a day, while writing
# messages about inert checkers. Neither did mine.
#
# NOTE THIS IS LOCAL ONLY — .git/hooks is not committed, so it protects this checkout
# and nobody else's. That is a real limit, stated rather than papered over.
set -e
# ⭐ DRIFT CHECK. This hook lives in .git/holobench-hooks/ — outside the blast radius
# of reset/checkout/clean, which is the whole point (qualcomm: "the detector cannot
# be the thing the failure removes"). The cost of living outside the tree is that it
# can silently diverge from the committed .githooks/ source. So compare, and refuse.
#
# ⚠️ AND A SECOND COST I DID NOT NOTICE I WAS PAYING (measured 2026-08-28). Living
# there requires `core.hooksPath = .git/holobench-hooks` in .git/config — a LOCAL
# setting, and local BEATS the fleet's global core.hooksPath. Verified in a scratch
# repo, not read from docs: with global=fleet and local=repo, the REPO hook runs.
# So the chain here is
#         git → .git/holobench-hooks/pre-push → exec → the fleet gate
# and the fleet gate runs ONLY because a repo-local file chooses to exec it.
#
# ⭐ .git/config IS NOT TRACKED BY ANY REPO. One line —
#       git config --local core.hooksPath /dev/null
# — disables every hook here, leaves no diff, appears in no history, and defeats every
# audit in this repo at once: nothing is gutted, so there is no installed-vs-source
# comparison to fail and no prose to be fooled by. The mechanism was never the file.
#
# So "outside the tree" is NOT "outside the repo's control". This move is real hardening
# against reset/checkout/clean and it is NOT hardening against a config edit; it trades a
# tracked-file exposure for an untracked-config one. Closing that needs a runner this
# machine's git cannot decline — CI — which does not exist here. Stated so the next
# reader does not inherit the stronger claim I was making.
ROOT="$(git rev-parse --show-toplevel)"
INSTALLED="$ROOT/.git/holobench-hooks/pre-commit"
SOURCE="$ROOT/.githooks/pre-commit"
if [ -f "$SOURCE" ] && ! cmp -s "$INSTALLED" "$SOURCE"; then
    echo "pre-commit: the INSTALLED hook differs from the committed .githooks/pre-commit." >&2
    echo "  Re-install with: cp .githooks/pre-commit .git/holobench-hooks/pre-commit" >&2
    echo "  REFUSING: a gate that has drifted from its source is not the gate the repo claims." >&2
    exit 1
fi

# ⭐ THIS RUNS BEFORE THE SUITE, AND THE ORDER IS THE POINT (fixed 2026-08-27).
# It used to sit at the END of this file — after the `no ../.venv → exit 0` skip. So on
# any checkout without a venv the hook exited 0 and NEVER CHECKED WHETHER THE PUSH GATE
# WAS ARMED. That is the worst possible placement: a fresh clone is precisely when .venv
# is absent AND when the fleet gate is most likely unarmed, so the guard built for fresh
# clones was disabled by the very condition that defines one. Found by applying
# qualcomm's test — disable one branch of a multi-part guard and re-plant — to my own
# hook rather than to my code.
#
# ⚠️ SELF-CHECK: this repo sets core.hooksPath=.githooks, which means a plain
# `git reset --hard` to a commit predating .githooks DELETES THE HOOKS DIRECTORY —
# and git then silently runs NO hooks at all, including the fleet's pre-push gate.
# That happened once, for about a minute, while wiring this up. A gate that a
# routine command can remove without a word is not a gate.
if [ ! -x "$(git rev-parse --show-toplevel)/.githooks/pre-push" ]; then
    echo "pre-commit: .githooks/pre-push is MISSING — the fleet push gate is NOT armed" >&2
    echo "  for this repo. Restore it before committing: git checkout .githooks" >&2
    exit 1
fi

cd "$(git rev-parse --show-toplevel)/backend"
if [ ! -x ../.venv/bin/python ]; then
    echo "pre-commit: no ../.venv — SKIPPING the suite." >&2
    echo "  ⚠️ A skip is not a pass. Commit proceeding, but THE SUITE was not run." >&2
    echo "     (The push-gate arming check above DID run — it is deliberately ahead of" >&2
    echo "      this skip, because a checkout with no venv is the likeliest to be" >&2
    echo "      missing the gate too.)" >&2
    exit 0
fi
echo "pre-commit: running the suite…"
../.venv/bin/python -m pytest tests/ -q || {
    echo "pre-commit: TESTS FAILED — commit refused." >&2
    echo "  (--no-verify bypasses this, and then 'tests green' is not a claim you hold.)" >&2
    exit 1
}
